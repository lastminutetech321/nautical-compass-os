{
  "name": "ai_agents",
  "fields": [
    {
      "name": "id",
      "type": "uuid",
      "primaryKey": true
    },
    {
      "name": "name",
      "type": "string",
      "required": true
    },
    {
      "name": "agent_type",
      "type": "string",
      "required": true
    },
    {
      "name": "status",
      "type": "string",
      "required": true,
      "default": "active"
    },
    {
      "name": "priority",
      "type": "integer",
      "default": 5
    },
    {
      "name": "active_tasks",
      "type": "integer",
      "default": 0
    },
    {
      "name": "last_task_at",
      "type": "datetime"
    },
    {
      "name": "capabilities",
      "type": "json"
    },
    {
      "name": "metadata",
      "type": "json"
    },
    {
      "name": "created_at",
      "type": "datetime",
      "default": "now()"
    },
    {
      "name": "updated_at",
      "type": "datetime",
      "default": "now()"
    }
  ],
  "indexes": [
    {
      "fields": ["status"]
    },
    {
      "fields": ["agent_type"]
    },
    {
      "fields": ["priority"]
    }
  ]
}
