{
  "name": "ApprovalGate",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "action_type": {
      "type": "string",
      "enum": [
        "send_email",
        "charge_customer",
        "change_pricing",
        "publish_legal_output",
        "deploy_code",
        "delete_data",
        "contact_third_party",
        "spend_money",
        "change_canon_law",
        "external_message",
        "hire_agent",
        "cancel_subscription"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "requested_by": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1
    },
    "requesting_agent": {
      "type": "string",
      "minLength": 1
    },
    "payload_summary": {
      "type": "string",
      "maxLength": 5000
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "high"
    },
    "linked_entity_type": {
      "type": "string",
      "pattern": "^[A-Z][a-zA-Z0-9]*$"
    },
    "linked_entity_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "reviewed_by": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string",
      "maxLength": 1000
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    },
    "authority_envelope": {
      "type": "object",
      "properties": {
        "requester_role": {
          "type": "string",
          "enum": ["human", "agent", "system"]
        },
        "requester_identity": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "ip_address": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      },
      "required": ["requester_role", "requester_identity", "timestamp"]
    },
    "approval_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "approver_id": {
            "type": "string"
          },
          "approver_role": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": ["approved", "rejected", "delegated"]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": ["approver_id", "action", "timestamp"]
      }
    },
    "risk_assessment": {
      "type": "object",
      "properties": {
        "financial_impact": {
          "type": "number"
        },
        "data_sensitivity": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "reversibility": {
          "type": "string",
          "enum": ["reversible", "partially_reversible", "irreversible"]
        },
        "compliance_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "action_type",
    "requested_by",
    "authority_envelope"
  ]
}