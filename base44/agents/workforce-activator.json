  "task_queues": {
    "high_priority": {
      "max_queue_size": 1000,
      "agent_types": ["task_executor", "workflow_coordinator", "error_handler"]
    },
    "medium_priority": {
      "max_queue_size": 5000,
      "agent_types": ["data_processor", "integration_handler", "monitoring_agent"]
    },
    "low_priority": {
      "max_queue_size": 10000,
      "agent_types": ["analytics_worker", "notification_dispatcher", "backup_scheduler"]
    },
    "background": {
      "max_queue_size": 50000,
      "agent_types": ["cache_manager", "optimization_worker"]
    }
  },
  "dispatch_rules": {
    "load_balancing": true,
    "prefer_idle_agents": true,
    "respect_agent_capacity": true,
    "auto_scale_thresholds": {
      "scale_up_queue_depth": 100,
      "scale_down_idle_time": 300
    }
  },
  "monitoring": {
    "track_dispatch_metrics": true,
    "log_agent_performance": true,
    "alert_on_failures": true,
    "metrics_retention_days": 30
  }
}
